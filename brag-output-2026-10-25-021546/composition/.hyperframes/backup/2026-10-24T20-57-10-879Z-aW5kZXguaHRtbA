<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1920, height=1080">
    <title>ADF AIO — Launch Video</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      :root {
        --bg: #0a0b10;
        --cyan: #00f5ff;
        --violet: #8a2be2;
        --coral: #ff5757;
        --gold: #ffd700;
        --ink: #ffffff;
        --ink-dim: #cbd5e1;
        --font-main: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html, body {
        width: 1920px;
        height: 1080px;
        overflow: hidden;
        background: var(--bg);
        font-family: var(--font-main);
        color: var(--ink);
      }

      #root {
        position: relative;
        width: 1920px;
        height: 1080px;
        background: radial-gradient(circle at 50% 30%, #151628 0%, #08090e 100%);
      }

      /* Ambient glowing background elements */
      .glow-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(120px);
        pointer-events: none;
        opacity: 0.45;
      }
      .orb-1 { width: 600px; height: 600px; background: #00f5ff; top: -100px; left: 15%; }
      .orb-2 { width: 700px; height: 700px; background: #8a2be2; bottom: -150px; right: 10%; }

      .grid-lines {
        position: absolute;
        inset: 0;
        background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
                          linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
        background-size: 80px 80px;
        opacity: 0.7;
      }

      /* Scene container */
      .scene {
        position: absolute;
        inset: 0;
        width: 1920px;
        height: 1080px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      }

      /* Badge */
      .pill-badge {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 10px 28px;
        background: rgba(0, 245, 255, 0.12);
        border: 1px solid rgba(0, 245, 255, 0.5);
        border-radius: 100px;
        color: var(--cyan);
        font-size: 28px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        margin-bottom: 24px;
        box-shadow: 0 0 25px rgba(0, 245, 255, 0.25);
      }
      .pill-badge .dot {
        width: 12px;
        height: 12px;
        background: var(--cyan);
        border-radius: 50%;
        box-shadow: 0 0 10px var(--cyan);
      }

      /* Scene 1: Neon Hook */
      .banner-box {
        position: relative;
        width: 820px;
        max-height: 280px;
        border-radius: 24px;
        overflow: hidden;
        border: 2px solid rgba(0, 245, 255, 0.4);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8), 0 0 50px rgba(0, 245, 255, 0.2);
        margin-bottom: 36px;
      }
      .banner-box img {
        width: 100%;
        height: auto;
        display: block;
      }

      .hero-title {
        font-size: 88px;
        font-weight: 900;
        letter-spacing: -0.03em;
        text-transform: uppercase;
        background: linear-gradient(135deg, #ffffff 30%, #00f5ff 70%, #8a2be2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-align: center;
        line-height: 1.05;
        margin-bottom: 20px;
      }

      .hero-sub {
        font-size: 34px;
        color: var(--ink-dim);
        font-weight: 600;
        letter-spacing: -0.01em;
        text-align: center;
      }

      /* Scene 2: Feature Cards */
      .cards-container {
        display: flex;
        gap: 36px;
        margin-top: 40px;
      }

      .feature-card {
        width: 440px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(20px);
        border-radius: 28px;
        padding: 40px 32px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6);
        position: relative;
        overflow: hidden;
      }
      .feature-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; height: 5px;
      }
      .card-1::before { background: linear-gradient(90deg, #ff5757, #ff8a00); }
      .card-2::before { background: linear-gradient(90deg, #00f5ff, #0070f3); }
      .card-3::before { background: linear-gradient(90deg, #8a2be2, #d946ef); }

      .card-icon {
        width: 72px;
        height: 72px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
        margin-bottom: 24px;
      }
      .card-1 .card-icon { background: rgba(255, 87, 87, 0.15); color: #ff5757; }
      .card-2 .card-icon { background: rgba(0, 245, 255, 0.15); color: #00f5ff; }
      .card-3 .card-icon { background: rgba(138, 43, 226, 0.15); color: #c084fc; }

      .card-tag {
        font-size: 28px;
        font-family: var(--font-mono);
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 12px;
      }
      .card-1 .card-tag { color: #ffa033; }
      .card-2 .card-tag { color: #00f5ff; }
      .card-3 .card-tag { color: #d8b4fe; }

      .card-title {
        font-size: 36px;
        font-weight: 800;
        margin-bottom: 12px;
        color: #ffffff;
      }

      .card-desc {
        font-size: 28px;
        color: #e2e8f0;
        line-height: 1.4;
        margin-bottom: 20px;
      }

      .card-formats {
        font-family: var(--font-mono);
        font-size: 28px;
        color: #cbd5e1;
        background: rgba(0, 0, 0, 0.6);
        padding: 8px 16px;
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.1);
      }

      /* Scene 3: Hardware Refresh Rate & Engine */
      .hud-display {
        display: flex;
        align-items: center;
        gap: 60px;
        margin-top: 30px;
      }

      .fps-dial {
        width: 320px;
        height: 320px;
        border-radius: 50%;
        border: 4px solid rgba(0, 245, 255, 0.2);
        border-top: 4px solid var(--cyan);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.6);
        box-shadow: 0 0 60px rgba(0, 245, 255, 0.2);
        position: relative;
      }

      .fps-number {
        font-family: var(--font-mono);
        font-size: 88px;
        font-weight: 900;
        color: var(--cyan);
        text-shadow: 0 0 30px rgba(0, 245, 255, 0.8);
        line-height: 1;
      }

      .fps-label {
        font-size: 28px;
        font-weight: 700;
        color: #e2e8f0;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-top: 10px;
      }

      .perf-details {
        display: flex;
        flex-direction: column;
        gap: 24px;
        max-width: 650px;
      }

      .perf-item {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 20px;
        padding: 24px 30px;
        display: flex;
        align-items: center;
        gap: 20px;
      }
      .perf-item-icon {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        background: rgba(0, 245, 255, 0.15);
        color: var(--cyan);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
      }
      .perf-item-text h3 {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 4px;
        color: #ffffff;
      }
      .perf-item-text p {
        font-size: 28px;
        color: #cbd5e1;
      }

      /* Scene 4: Outro */
      .outro-card {
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .format-badges {
        display: flex;
        gap: 16px;
        margin: 28px 0 40px 0;
      }

      .fmt-chip {
        padding: 12px 28px;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.2);
        font-family: var(--font-mono);
        font-size: 28px;
        font-weight: 700;
        color: #ffffff;
      }

      .cta-btn {
        padding: 24px 64px;
        background: linear-gradient(135deg, #00f5ff, #8a2be2);
        color: #000000;
        font-size: 32px;
        font-weight: 800;
        border-radius: 100px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        box-shadow: 0 0 50px rgba(0, 245, 255, 0.6);
      }

    </style>
  </head>
  <body>
    <div data-hf-id="hf-dcwt" id="root" data-composition-id="main" data-start="0" data-duration="18" data-width="1920" data-height="1080">
      <!-- Background Audio & SFX inside root -->
      <audio data-hf-id="hf-xj9w" id="bg-music" class="clip" data-start="0" data-duration="18" data-track-index="10" data-volume="0.35" src="assets/music.mp3"></audio>
      <audio data-hf-id="hf-capb" id="sfx-bell-1" class="clip" data-start="0.1" data-duration="1.48" data-track-index="11" data-volume="0.75" src="assets/sfx/impact/impactBell_heavy_000.ogg"></audio>
      <audio data-hf-id="hf-1xnh" id="sfx-drop-1" class="clip" data-start="4.2" data-duration="0.11" data-track-index="12" data-volume="0.65" src="assets/sfx/interface/drop_001.ogg"></audio>
      <audio data-hf-id="hf-4zl9" id="sfx-drop-2" class="clip" data-start="4.6" data-duration="0.11" data-track-index="13" data-volume="0.65" src="assets/sfx/interface/drop_001.ogg"></audio>
      <audio data-hf-id="hf-w6kc" id="sfx-drop-3" class="clip" data-start="5.0" data-duration="0.11" data-track-index="14" data-volume="0.65" src="assets/sfx/interface/drop_001.ogg"></audio>
      <audio data-hf-id="hf-4kmk" id="sfx-click" class="clip" data-start="8.6" data-duration="0.10" data-track-index="15" data-volume="0.6" src="assets/sfx/interface/click_001.ogg"></audio>
      <audio data-hf-id="hf-5ame" id="sfx-bell-outro" class="clip" data-start="13.7" data-duration="1.48" data-track-index="16" data-volume="0.8" src="assets/sfx/impact/impactBell_heavy_000.ogg"></audio>

      <div data-hf-id="hf-6b7n" class="glow-orb orb-1" data-layout-allow-overflow=""></div>
