            <span data-hf-id="hf-eod3" class="fmt-chip">AI ASSISTANT</span>
          </div>
          <div data-hf-id="hf-rbyi" class="cta-btn">Explore ADF AIO</div>
        </div>
      </div>
    </div>

    <script>
      const tl = gsap.timeline({ paused: true });

      // Scene 1 Timeline (0.0s - 4.0s) - Title and banner present from frame 0 for social player thumbnail
      tl.set("#scene-1", { opacity: 1 }, 0);
      tl.fromTo("#s1-badge", { y: -10, opacity: 0.8 }, { y: 0, opacity: 1, duration: 0.4, ease: "power2.out" }, 0.0);
      tl.fromTo("#s1-banner", { scale: 0.95 }, { scale: 1, duration: 0.6, ease: "power2.out" }, 0.0);
      tl.fromTo("#s1-title", { y: 15 }, { y: 0, duration: 0.5, ease: "power2.out" }, 0.0);
      tl.fromTo("#s1-sub", { y: 10, opacity: 0.8 }, { y: 0, opacity: 1, duration: 0.5, ease: "power2.out" }, 0.1);
      // Scene 1 Out
      tl.to("#scene-1", { opacity: 0, scale: 0.95, duration: 0.4, ease: "power2.in" }, 3.7);

      // Scene 2 Timeline (4.0s - 8.5s)
      tl.to("#scene-2", { opacity: 1, duration: 0.3, ease: "power2.out" }, 4.0);
      tl.fromTo("#s2-badge", { y: -20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4, ease: "power2.out" }, 4.1);
      tl.fromTo("#s2-title", { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: "power2.out" }, 4.2);
      tl.fromTo("#card-1", { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: "power3.out" }, 4.3);
      tl.fromTo("#card-2", { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: "power3.out" }, 4.6);
      tl.fromTo("#card-3", { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: "power3.out" }, 4.9);
      // Scene 2 Out
      tl.to("#scene-2", { opacity: 0, y: -20, duration: 0.4, ease: "power2.in" }, 8.2);

      // Scene 3 Timeline (8.5s - 13.5s)
      tl.to("#scene-3", { opacity: 1, duration: 0.3, ease: "power2.out" }, 8.5);
      tl.fromTo("#s3-badge", { y: -20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4, ease: "power2.out" }, 8.6);
      tl.fromTo("#s3-title", { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: "power2.out" }, 8.7);
      tl.fromTo("#s3-dial", { scale: 0.7, opacity: 0, rotation: -45 }, { scale: 1, opacity: 1, rotation: 0, duration: 0.7, ease: "back.out(1.5)" }, 8.9);
      tl.fromTo("#s3-details", { x: 40, opacity: 0 }, { x: 0, opacity: 1, duration: 0.6, ease: "power3.out" }, 9.2);
      // Gentle ongoing dial pulse to eliminate dead stretch
      tl.to("#s3-dial", { scale: 1.04, duration: 1.5, yoyo: true, repeat: 1, ease: "sine.inOut" }, 10.0);
      // Scene 3 Out
      tl.to("#scene-3", { opacity: 0, scale: 1.05, duration: 0.4, ease: "power2.in" }, 13.2);

      // Scene 4 Timeline (13.5s - 18.0s)
      tl.to("#scene-4", { opacity: 1, duration: 0.4, ease: "power2.out" }, 13.5);
      tl.fromTo("#s4-content", { scale: 0.9, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.7, ease: "back.out(1.4)" }, 13.7);

      window.__timelines = window.__timelines || {};
      window.__timelines["main"] = tl;
      tl.seek(0);
    </script>
