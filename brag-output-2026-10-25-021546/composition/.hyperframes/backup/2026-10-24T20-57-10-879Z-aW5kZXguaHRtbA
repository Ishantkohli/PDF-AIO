      <!-- Scene 1: The Neon Hook (0s - 4.0s) -->
      <div data-hf-id="hf-v3at" id="scene-1" class="scene clip" data-start="0" data-duration="4.2" data-track-index="1">
        <div data-hf-id="hf-quwh" class="pill-badge" id="s1-badge"><span data-hf-id="hf-9gry" class="dot"></span> Next-Gen Android Architecture</div>
        <div data-hf-id="hf-2fyr" class="banner-box" id="s1-banner">
          <img data-hf-id="hf-r1t8" src="assets/banner.gif" alt="ADF AIO Neon Banner">
        </div>
        <h1 data-hf-id="hf-bff2" class="hero-title" id="s1-title">AADF AIO</h1>
        <p data-hf-id="hf-npwh" class="hero-sub" id="s1-sub">All in One. Everything You Need.</p>
      </div>

      <!-- Scene 2: Unified Conversion Hub (4.0s - 8.5s) -->
      <div data-hf-id="hf-hhwe" id="scene-2" class="scene clip" data-start="4.0" data-duration="4.7" data-track-index="2">
        <div data-hf-id="hf-q0kl" class="pill-badge" id="s2-badge"><span data-hf-id="hf-zcc2" class="dot"></span> Native Conversion Engine</div>
        <h2 data-hf-id="hf-qcc1" class="hero-title" style="font-size: 64px;" id="s2-title">UNIFIED CONVERSION HUB</h2>
        <div data-hf-id="hf-w0cf" class="cards-container">
          <div data-hf-id="hf-ci9p" class="feature-card card-1" id="card-1">
            <div data-hf-id="hf-f85d" class="card-icon">📸</div>
            <div data-hf-id="hf-oajb" class="card-tag">MOST POPULAR</div>
            <div data-hf-id="hf-7qjg" class="card-title">Images to PDF</div>
            <div data-hf-id="hf-caym" class="card-desc">Compile camera captures &amp; graphics into crisp multi-page documents.</div>
            <div data-hf-id="hf-fp2p" class="card-formats">PNG, JPG, WebP, HEIF</div>
          </div>
          <div data-hf-id="hf-hi5x" class="feature-card card-2" id="card-2">
            <div data-hf-id="hf-thg7" class="card-icon">⚡</div>
            <div data-hf-id="hf-p6ap" class="card-tag">ULTRA HD 216 DPI</div>
            <div data-hf-id="hf-4f2e" class="card-title">PDF to Images</div>
            <div data-hf-id="hf-yw7v" class="card-desc">Render full PDF sheets into lossless graphics and ZIP archives.</div>
            <div data-hf-id="hf-ef0o" class="card-formats">Lossless PNG, High-DPI JPEG</div>
          </div>
          <div data-hf-id="hf-88j5" class="feature-card card-3" id="card-3">
            <div data-hf-id="hf-633q" class="card-icon">📑</div>
            <div data-hf-id="hf-ffok" class="card-tag">OPENXML ENGINE</div>
            <div data-hf-id="hf-agz2" class="card-title">Word to PDF</div>
            <div data-hf-id="hf-krdv" class="card-desc">Format Word files into standardized PDF prints completely on-device.</div>
            <div data-hf-id="hf-je34" class="card-formats">DOCX, DOC, Rich Text</div>
          </div>
        </div>
      </div>

      <!-- Scene 3: Hardware Acceleration & High FPS (8.5s - 13.5s) -->
      <div data-hf-id="hf-a4ap" id="scene-3" class="scene clip" data-start="8.5" data-duration="5.2" data-track-index="3">
        <div data-hf-id="hf-vy8e" class="pill-badge" id="s3-badge"><span data-hf-id="hf-zqn3" class="dot"></span> Unlocked Performance</div>
        <h2 data-hf-id="hf-dkuf" class="hero-title" style="font-size: 64px;" id="s3-title">BLAZING ON-DEVICE SPEED</h2>
        <div data-hf-id="hf-vrpy" class="hud-display">
          <div data-hf-id="hf-mkjb" class="fps-dial" id="s3-dial">
            <div data-hf-id="hf-ykfe" class="fps-number" id="s3-fps-num">165</div>
            <div data-hf-id="hf-5e7d" class="fps-label">FPS Dynamic Lock</div>
          </div>
          <div data-hf-id="hf-hbh9" class="perf-details" id="s3-details">
            <div data-hf-id="hf-r7zf" class="perf-item">
              <div data-hf-id="hf-rnyq" class="perf-item-icon">🚀</div>
              <div data-hf-id="hf-smrt" class="perf-item-text">
                <h3 data-hf-id="hf-qvc4">Hardware Refresh Rate Tuning</h3>
                <p data-hf-id="hf-znzy">Silky smooth navigation across 60Hz, 90Hz, 120Hz, and 165Hz displays.</p>
              </div>
            </div>
            <div data-hf-id="hf-1n9n" class="perf-item">
              <div data-hf-id="hf-7lp8" class="perf-item-icon">🔒</div>
              <div data-hf-id="hf-m0cd" class="perf-item-text">
                <h3 data-hf-id="hf-mbem">100% Local On-Device Processing</h3>
                <p data-hf-id="hf-82qs">Zero cloud latency, complete privacy, zero telemetry data leakage.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Scene 4: Outro & Punchline (13.5s - 18.0s) -->
      <div data-hf-id="hf-zlxf" id="scene-4" class="scene clip" data-start="13.5" data-duration="4.5" data-track-index="4">
        <div data-hf-id="hf-rrgz" class="outro-card" id="s4-content">
          <div data-hf-id="hf-qbam" class="pill-badge"><span data-hf-id="hf-04y4" class="dot"></span> The Modern Standard</div>
          <h1 data-hf-id="hf-twjn" class="hero-title" style="font-size: 80px; margin-bottom: 12px;">ADF AIO</h1>
          <p data-hf-id="hf-skzm" class="hero-sub" style="font-size: 36px; color: #ffffff; font-weight: 700;">All in One, For You.</p>
          <div data-hf-id="hf-zwdu" class="format-badges">
            <span data-hf-id="hf-lz2l" class="fmt-chip">PDF</span>
            <span data-hf-id="hf-ioqn" class="fmt-chip">DOCX</span>
            <span data-hf-id="hf-cg1e" class="fmt-chip">XLSX</span>
            <span data-hf-id="hf-zfv5" class="fmt-chip">PPTX</span>
